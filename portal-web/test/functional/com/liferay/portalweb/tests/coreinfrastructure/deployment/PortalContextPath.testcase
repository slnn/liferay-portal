@component-name = "core-infrastructure"
definition {

	property ci.retries.disabled = "true";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Deployment";

	@description = "LPD-33643 Verify Glowroot works with non root context."
    @priority = 5
    test VisitGlowrootWithNonRootContext {
    	property portal.acceptance = "true";
    	property portal.context = "liferay";
    	property skip.clean-app-server-deploy-dir = "true";
    	property test.liferay.virtual.instance = "false";
    	property test.run.type = "single";

    	task ("Visit Glowroot page with non root context") {
    	    AntCommands.runCommand("build-test.xml", "stop-app-server");
    	    AntCommands.runCommand("build-test.xml", "enable-glowroot-for-tomcat");
    		SignIn.signInSpecificURL(userPassword = "test", userEmailAddress = "test@liferay.com", url = "http://localhost:8080/liferay");
    		Navigator.openSpecificURL(url = "http://localhost:8080/liferay/o/glowroot");
    		AssertElementPresent(locator1 = "Home#GLOWROOT");
    	}
    }
}